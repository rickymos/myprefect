# Copy this file to services/.prefect.env and adjust the external URL values.
# The systemd unit files load services/.prefect.env if it exists.

PREFECT_HOME=/home/tdm/Documents/prefect/.prefect

# Serve Prefect under a path on your existing host.
PREFECT_UI_SERVE_BASE=/prefect/
PREFECT_SERVER_API_BASE_PATH=/prefect/api

# Internal API URL used by worker and deployment registration.
# Keep this localhost-only and publish Prefect through nginx.
PREFECT_API_URL=http://127.0.0.1:4200/prefect/api

# External URLs shown in the UI and generated links.
PREFECT_UI_API_URL=http://127.0.0.1:4200/prefect/api
PREFECT_UI_URL=http://127.0.0.1:4200/prefect

# Deployment registration uses this pool by default.
PREFECT_WORK_POOL_NAME=default-agent-pool
